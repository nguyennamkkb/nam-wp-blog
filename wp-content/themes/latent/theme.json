{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"customDuotone": false,
			"palette": [
				{
					"slug": "base",
					"color": "#FBFAF7",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#15171C",
					"name": "Contrast"
				},
				{
					"slug": "accent",
					"color": "#2F5BFF",
					"name": "Accent"
				},
				{
					"slug": "accent-2",
					"color": "#C9F24D",
					"name": "Accent 2"
				},
				{
					"slug": "muted",
					"color": "#6E6A61",
					"name": "Muted"
				},
				{
					"slug": "surface",
					"color": "#F2EFE7",
					"name": "Surface"
				},
				{
					"slug": "border",
					"color": "#E3DFD4",
					"name": "Border"
				},
				{
					"slug": "code-bg",
					"color": "#101318",
					"name": "Code Background"
				},
				{
					"slug": "code-text",
					"color": "#E9E7DF",
					"name": "Code Text"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "newsreader",
					"name": "Newsreader",
					"fontFamily": "\"Newsreader\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/newsreader-vietnamese-var.woff2"
							],
							"unicodeRange": "U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB"
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/newsreader-latin-var.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-vietnamese-var.woff2"
							],
							"unicodeRange": "U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB"
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-var.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "jetbrains-mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/jetbrains-mono-latin-var.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "body",
					"name": "Body",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "lead",
					"name": "Lead",
					"size": "1.25rem"
				},
				{
					"slug": "h3",
					"name": "Heading 3",
					"size": "1.5rem"
				},
				{
					"slug": "h2",
					"name": "Heading 2",
					"size": "1.875rem"
				},
				{
					"slug": "h1",
					"name": "Heading 1",
					"size": "2.5rem"
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "4.5rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "20",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "30",
					"size": "0.75rem"
				},
				{
					"slug": "40",
					"name": "40",
					"size": "1rem"
				},
				{
					"slug": "50",
					"name": "50",
					"size": "1.5rem"
				},
				{
					"slug": "60",
					"name": "60",
					"size": "2rem"
				},
				{
					"slug": "70",
					"name": "70",
					"size": "3rem"
				},
				{
					"slug": "80",
					"name": "80",
					"size": "4rem"
				},
				{
					"slug": "90",
					"name": "90",
					"size": "6rem"
				}
			]
		},
		"border": {
			"radius": true,
			"radiusSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "2px"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "6px"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "12px"
				},
				{
					"slug": "full",
					"name": "Full",
					"size": "999px"
				}
			]
		},
		"custom": {
			"tocWidth": "240px",
			"headerHeight": "72px",
			"transition": "200ms",
			"transitionSlow": "320ms"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|inter",
			"fontSize": "var:preset|font-size|body",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|50"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|newsreader",
					"fontWeight": "600",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0.5em"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|h1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|h2"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|h3"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|lead"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|body"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|contrast"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"color": {
						"text": "var:preset|color|contrast"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|base"
				},
				"border": {
					"radius": "var:preset|border-radius|medium"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"letterSpacing": "0.01em",
					"textDecoration": "none"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|50",
						"right": "var:preset|spacing|50"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.5"
				}
			},
			"cite": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontSize": "var:preset|font-size|small",
					"fontStyle": "normal"
				}
			},
			"label": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500"
				}
			},
			"textInput": {
				"color": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|contrast"
				},
				"border": {
					"color": "var:preset|color|border",
					"radius": "var:preset|border-radius|medium",
					"style": "solid",
					"width": "1px"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontSize": "var:preset|font-size|body"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40"
					}
				},
				":focus": {
					"border": {
						"color": "var:preset|color|accent"
					}
				}
			},
			"select": {
				"color": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|contrast"
				},
				"border": {
					"color": "var:preset|color|border",
					"radius": "var:preset|border-radius|medium",
					"style": "solid",
					"width": "1px"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontSize": "var:preset|font-size|body"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40"
					}
				}
			}
		},
		"blocks": {
			"core/code": {
				"color": {
					"background": "var:preset|color|code-bg",
					"text": "var:preset|color|code-text"
				},
				"border": {
					"radius": "var:preset|border-radius|large"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|jetbrains-mono",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.6"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|50",
						"bottom": "var:preset|spacing|50",
						"left": "var:preset|spacing|50",
						"right": "var:preset|spacing|50"
					}
				}
			},
			"core/preformatted": {
				"color": {
					"background": "var:preset|color|code-bg",
					"text": "var:preset|color|code-text"
				},
				"border": {
					"radius": "var:preset|border-radius|large"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|jetbrains-mono",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.6"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|50",
						"bottom": "var:preset|spacing|50",
						"left": "var:preset|spacing|50",
						"right": "var:preset|spacing|50"
					}
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|accent",
						"style": "solid",
						"width": "3px"
					}
				},
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|newsreader",
					"fontSize": "var:preset|font-size|lead",
					"fontStyle": "italic",
					"lineHeight": "1.4"
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|50"
					}
				}
			},
			"core/separator": {
				"border": {
					"color": "var:preset|color|border",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|border"
				}
			},
			"core/search": {
				"border": {
					"radius": "var:preset|border-radius|medium"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|inter"
				}
			}
		}
	}
}
