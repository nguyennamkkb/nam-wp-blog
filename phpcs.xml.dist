<?xml version="1.0"?>
<ruleset name="Latent">
	<description>PHP_CodeSniffer rules for the Latent theme and latent-core plugin.</description>

	<!-- Files to scan: only the custom theme and plugin. -->
	<file>wp-content/themes/latent</file>
	<file>wp-content/plugins/latent-core</file>

	<!-- Never scan third-party code or generated/runtime directories. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/wp-content/uploads/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!-- WordPress Coding Standards (Core + Extra + Docs). -->
	<rule ref="WordPress"/>

	<!-- PHP compatibility checks against the minimum supported PHP version. -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- Project targets WordPress 6.6+ and PHP 8.2+. -->
	<config name="minimum_supported_wp_version" value="6.6"/>
	<config name="testVersion" value="8.2-"/>
</ruleset>
